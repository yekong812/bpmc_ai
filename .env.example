# MariaDB
DATABASE_URL=mysql://user:password@localhost:3306/church_ai

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=church_documents

# Auth (최소 32자 권장)
AUTH_SECRET=change-me-to-a-long-random-secret

# Object Storage (PDF 원본)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Session
AUTH_COOKIE_NAME=church_admin_session
AUTH_SESSION_DAYS=7

# Admin seed (npm run db:init)
ADMIN_SEED_LOGIN_ID=admin
ADMIN_SEED_PASSWORD=admin1234!
ADMIN_SEED_NAME=관리자

# PDF upload
PDF_MAX_BYTES=10485760

# RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
OPENAI_EMBEDDING_DIMS=1536
